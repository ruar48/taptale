APP_NAME=Taptale
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 — all uploads are stored here
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET=

VITE_APP_NAME="${APP_NAME}"

# Taptale storefront (amounts in centavos)
TAPTALE_DELIVERY_FEE=15000
TAPTALE_FREE_DELIVERY_THRESHOLD=300000
TAPTALE_MEDIA_DISK=r2
TAPTALE_UPLOADS_DISK=r2_private
TAPTALE_MAX_UPLOAD_KB=10240

# Design proofs with no reply are approved automatically after this many hours (0 = off)
TAPTALE_PROOF_AUTO_APPROVE_HOURS=24

# Business details shown on the About, policy and legal pages (empty = hidden)
TAPTALE_BUSINESS_NAME=Taptale
TAPTALE_CONTACT_EMAIL=
TAPTALE_CONTACT_PHONE=
TAPTALE_BUSINESS_ADDRESS=
TAPTALE_FACEBOOK_URL=
TAPTALE_INSTAGRAM_URL=
TAPTALE_POLICIES_UPDATED_ON=2026-11-24

# PayMongo (Developers → API keys / Webhooks). Use sk_test_ keys until go-live.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHOD_TYPES=qrph
PAYMONGO_WEBHOOK_TOLERANCE=300
PAYMONGO_QR_EXPIRY_SECONDS=900
